// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  name              String
  role              String   @default("STUDENT") // STUDENT, DELIVERY_PERSONNEL, VENDOR, ADMIN
  profilePhoto      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentProfile    StudentProfile?
  deliveryProfile   DeliveryProfile?
  vendorProfile     VendorProfile?
  
  orders            Order[]
  reviews           Review[]
  loyaltyPoints     LoyaltyPoint[]
  wishlist          WishlistItem[]
}

model StudentProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  collegeName       String
  hostelName        String
  roomNumber        String
  gender            String
  course            String?
  yearOfStudy       Int?
  subscriptionStatus String            @default("NONE")
  subscriptionEnd   DateTime?
  roomCode          String?            @unique
  loyaltyBalance    Int                @default(0)
  pointsTier        String             @default("STARTER")
}

model DeliveryProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User               @relation(fields: [userId], references: [id])
  idProofUrl        String
  vehicleType       String
  isVerified        Boolean  @default(false)
  rating            Float    @default(0.0)
  totalDeliveries   Int      @default(0)
  
  deliveries        Order[]
}

model VendorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User               @relation(fields: [userId], references: [id])
  shopName          String
  shopLocation      String
  
  products          Product[]
}

model Product {
  id                String   @id @default(uuid())
  name              String
  description       String?
  price             Float
  category          String
  imageUrl          String?
  stock             Int      @default(0)
  vendorId          String
  vendor            VendorProfile @relation(fields: [vendorId], references: [id])
  
  isNearExpiry      Boolean  @default(false)
  expiryDate        DateTime?
  discountPrice     Float?
  
  reviews           Review[]
  orderItems        OrderItem[]
  wishlistedBy      WishlistItem[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Order {
  id                String   @id @default(uuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id])
  deliveryId        String?
  deliveryPerson    DeliveryProfile? @relation(fields: [deliveryId], references: [id])
  
  status            String @default("PENDING")
  orderType         String   @default("REGULAR")
  totalAmount       Float
  deliveryCharge    Float       @default(0)
  discountAmount    Float       @default(0)
  pointsUsed        Int         @default(0)
  
  isGroupOrder      Boolean     @default(false)
  roomCode          String?
  
  items             OrderItem[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int
  priceAtPurchase   Float
}

model Review {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])
  deliveryId        String?
  rating            Int
  comment           String?
  photos            String? // Comma separated URLs
  tags              String? // Comma separated tags
  
  createdAt         DateTime @default(now())
}

model LoyaltyPoint {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  points            Int
  type              String   // EARNED, REDEEMED
  reason            String?
  createdAt         DateTime @default(now())
}

model WishlistItem {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  addedAt           DateTime @default(now())
}

model CalendarEvent {
  id                String   @id @default(uuid())
  collegeName       String
  eventName         String
  startDate         DateTime
  endDate           DateTime
  type              String   // EXAM, FEST, HOLIDAY
}
